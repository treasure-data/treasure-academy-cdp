_export:
  !include : config/params.yml

+ingest:
  py>: py_scripts.data.upload_dataset
  database: ${td.database}
  table: ${source_table}
  docker:
    image: "treasuredata/customscript-python:3.12.11-td0"
  _env:
    TD_API_KEY: ${secret:td.apikey}
    TD_API_SERVER: "https://api.treasuredata.com"
